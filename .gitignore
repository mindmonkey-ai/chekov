# Build output (§11: generated assets are never committed; Cargo.lock IS
# committed — binary crate, §D.7).
/target

# Downloaded weights and runtime state — one dir per model@rev, gigabytes each.
/models/
/logs/
# Machine-local registry (absolute paths) + generated launcher + engine checkout.
/models.toml
/bin/
/llama.cpp/

# Generated agent config dirs written by `chekov launch` (carry forward the
# user's real settings, so they hold machine-local MCP and plugin state).
/agents/

# Integration backups written by `chekov integrate` (<file>.bak-<UTC>).
*.bak-*

# Generated zsh completions (rebuilt by `make install`).
/shell/_chekov

# Machine-local tunables — copy config.example.toml to config.toml.
/config.toml

# Agent/tooling state and local session dumps — never part of the release.
/.claude/
/.scout/
/session*.json
/review-contex*.json
